module.exports = {"data":{"profile":{"id":"fc27a672-b086-5b14-95f2-49c7b084b4b9","content":"<p><div class=\"content-block \"><p>You’re not just looking for a DJ to play music, you want someone who understands how important your day is. I bring the right energy at the right time, keep everything flowing smoothly and help create moments your guests will remember.</p></div></p>\n<p><div class=\"content-block \"><p>With over 20 years of experience as a DJ, MC and event professional, I specialize in turning weddings, corporate events and fundraisers across the North Shore and Greater Boston into unforgettable celebrations. Professional, organized and upbeat, I make it easy for you to relax and enjoy your best day ever.</p></div></p>\n","title":"Marty Miz","acf":{"title":"","video":"","facebook":"","instagram":"","testimonials":"<div class=\"content-block content-block-testimonial \"><p><br />\nMarty was an amazing DJ and master of ceremonies for our recent wedding! He was incredibly professional, full of great ideas, and extremely perceptive when reading the crowd. Our wedding was beautiful and Marty added that special touch that took it over the top! Highly recommend him for any special event.<br />\n</p><p class=\"from\">Hanna G. - Grove at Briar Barn Inn, August 2025</p></div>\n<div class=\"content-block content-block-testimonial \"><p><br />\nWe got married on 11/23/24. Marty was our DJ and was absolutely amazing! We wanted to change a few of the traditional parts of the wedding reception and he was more than accommodating. He helped us come up with ideas to incorporate the guests and start our wedding with high energy. He was always quick to respond and a great help in guiding us on how to find the right flow for our wedding to help get the vibe we were looking for. Guests of all ages were on the dance floor all night and there was never a lull! Since our wedding we have heard from so many people how much fun they had and a big part of that is because we had a great DJ that helped create the best energy for our wedding night!<br />\n</p><p class=\"from\">Alicia V - The Red Barn at Outlook Farm, November 2024</p></div>\n"},"image":{"localFile":{"childImageSharp":{"thumbnail":{"base64":"data:image/jpeg;base64,","aspectRatio":0.9769041769041769,"src":"/static/dd69c44e0f4d99e06f21ef27028a90dc-be8a1106af58abe32498713825af65cd-d0643.jpg","srcSet":"/static/dd69c44e0f4d99e06f21ef27028a90dc-be8a1106af58abe32498713825af65cd-2c2fe.jpg 110w,\n/static/dd69c44e0f4d99e06f21ef27028a90dc-be8a1106af58abe32498713825af65cd-a2e2b.jpg 220w,\n/static/dd69c44e0f4d99e06f21ef27028a90dc-be8a1106af58abe32498713825af65cd-d0643.jpg 440w,\n/static/dd69c44e0f4d99e06f21ef27028a90dc-be8a1106af58abe32498713825af65cd-77eb3.jpg 660w,\n/static/dd69c44e0f4d99e06f21ef27028a90dc-be8a1106af58abe32498713825af65cd-78eca.jpg 880w,\n/static/dd69c44e0f4d99e06f21ef27028a90dc-be8a1106af58abe32498713825af65cd-6ece6.jpg 1320w,\n/static/dd69c44e0f4d99e06f21ef27028a90dc-be8a1106af58abe32498713825af65cd-1a86f.jpg 1988w","sizes":"(max-width: 440px) 100vw, 440px","originalImg":"/static/dd69c44e0f4d99e06f21ef27028a90dc-be8a1106af58abe32498713825af65cd-1a86f.jpg"},"full":{"src":"/static/dd69c44e0f4d99e06f21ef27028a90dc-be8a1106af58abe32498713825af65cd-10d9a.jpg","height":409,"width":400,"srcSet":"/static/dd69c44e0f4d99e06f21ef27028a90dc-be8a1106af58abe32498713825af65cd-10d9a.jpg 1x,\n/static/dd69c44e0f4d99e06f21ef27028a90dc-be8a1106af58abe32498713825af65cd-738fa.jpg 1.5x,\n/static/dd69c44e0f4d99e06f21ef27028a90dc-be8a1106af58abe32498713825af65cd-4042a.jpg 2x,\n/static/dd69c44e0f4d99e06f21ef27028a90dc-be8a1106af58abe32498713825af65cd-935ac.jpg 3x"}}}},"yoast":{"title":"","canonical":"","metaDescription":"","linkdex":"","metakeywords":"","noIndex":"","noFollow":"","meta_robots_adv":"","metaKeywords":"","redirect":"","ogTitle":"","ogDescription":"","ogImage":"","twitterTitle":"","twitterDescription":"","twitterImage":""}},"site":{"id":"Site","siteMeta":{"title":"C-Zone Entertainment","subtitle":"Premiere DJs & Musicians | Servicing Greater Boston & New England | 617.320.0723"}}},"pathContext":{"id":"fc27a672-b086-5b14-95f2-49c7b084b4b9"}}


